<h1 class="display text-4xl md:text-5xl font-extrabold text-bone">Log activity</h1>

<div class="mt-8 max-w-xl">
  <p class="text-sm text-gray-400 mb-4">Contact: <%= @contact.name %></p>

  <%= form_with model: @activity, url: contact_activities_path(@contact), local: true do |f| %>
    <% if @activity.errors.any? %>
      <div role="alert" class="bg-moss text-madder border-l-4 border-madder px-4 py-2 mb-6">
        <ul class="list-disc list-inside">
          <% @activity.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :kind, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.select :kind, options_for_select([["Note", "note"], ["Call", "call"], ["Email", "email"], ["Meeting", "meeting"]], @activity.kind), {}, class: "input" %>
      </div>
      <div>
        <%= f.label :lead_id, "Related lead (optional)", class: "block text-sm text-gray-400 mb-1" %>
        <%= f.collection_select :lead_id, @leads, :id, :title, { include_blank: "None" }, class: "input" %>
      </div>
      <div>
        <%= f.label :body, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_area :body, rows: 4, class: "input" %>
      </div>
      <div>
        <%= f.label :performed_at, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.datetime_field :performed_at, class: "input" %>
      </div>
      <div class="flex gap-4">
        <%= f.submit "Log activity", class: "btn-primary" %>
        <%= link_to "Cancel", contact_path(@contact), class: "btn-quiet" %>
      </div>
    </div>
  <% end %>
</div>
