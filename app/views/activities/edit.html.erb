<h1 class="text-2xl font-bold text-gray-100 mb-8">Edit Activity</h1>

<div class="bg-gray-800 border border-gray-700 rounded-lg p-6 max-w-2xl">
  <p class="text-sm text-gray-400 mb-4">Contact: <%= @activity.contact.name %></p>

  <%= form_with model: @activity, local: true do |f| %>
    <% if @activity.errors.any? %>
      <div class="bg-red-900/50 text-red-300 border border-red-700 px-4 py-2 rounded mb-4">
        <ul class="list-disc list-inside">
          <% @activity.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :kind, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.select :kind, options_for_select([["Note", "note"], ["Call", "call"], ["Email", "email"], ["Meeting", "meeting"]], @activity.kind), {}, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :body, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_area :body, rows: 4, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :performed_at, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.datetime_field :performed_at, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div class="flex gap-4">
        <%= f.submit "Update Activity", class: "bg-cyan-600 text-white px-6 py-2 rounded-lg hover:bg-cyan-700" %>
        <%= link_to "Cancel", activity_path(@activity), class: "bg-gray-700 text-gray-300 px-6 py-2 rounded-lg hover:bg-gray-600" %>
      </div>
    </div>
  <% end %>
</div>
