<h1 class="display text-4xl md:text-5xl font-extrabold text-bone"><%= @activity.kind.humanize %></h1>
<p class="mt-2 text-gray-400">
  <time datetime="<%= @activity.performed_at&.iso8601 %>"><%= @activity.performed_at&.strftime("%b %d, %Y %H:%M") %></time>
</p>

<p class="mt-8 max-w-prose text-lg text-bone"><%= @activity.body %></p>

<dl class="mt-8 space-y-3 text-sm">
  <div>
    <dt class="text-gray-400">Contact</dt>
    <dd><%= link_to @activity.contact.name, contact_path(@activity.contact), class: "text-bone underline underline-offset-4 hover:text-lichen" %></dd>
  </div>
  <% if @activity.lead %>
    <div>
      <dt class="text-gray-400">Lead</dt>
      <dd><%= link_to @activity.lead.title, lead_path(@activity.lead), class: "text-bone underline underline-offset-4 hover:text-lichen" %></dd>
    </div>
  <% end %>
  <div>
    <dt class="text-gray-400">Logged by</dt>
    <dd class="text-bone"><%= @activity.user.email %></dd>
  </div>
</dl>

<div class="mt-10 flex flex-wrap items-center gap-3">
  <%= link_to "Edit", edit_activity_path(@activity), class: "btn-quiet" %>
  <%= button_to "Delete", activity_path(@activity), method: :delete, form_class: "inline", class: "btn-quiet text-madder border-madder", data: { turbo_confirm: "Delete this activity?" } %>
  <%= link_to "Back", contact_path(@activity.contact), class: "text-gray-400 hover:text-bone ml-2" %>
</div>
