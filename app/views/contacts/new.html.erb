<h1 class="display text-4xl md:text-5xl font-extrabold text-bone">New contact</h1>

<div class="mt-8 max-w-xl">
  <%= form_with model: @contact, local: true do |f| %>
    <% if @contact.errors.any? %>
      <div role="alert" class="bg-moss text-madder border-l-4 border-madder px-4 py-2 mb-6">
        <ul class="list-disc list-inside">
          <% @contact.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :name, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :name, class: "input" %>
      </div>
      <div>
        <%= f.label :email, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.email_field :email, class: "input" %>
      </div>
      <div>
        <%= f.label :phone, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :phone, class: "input" %>
      </div>
      <div>
        <%= f.label :company, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :company, class: "input" %>
      </div>
      <div>
        <%= f.label :position, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :position, class: "input" %>
      </div>
      <div>
        <%= f.label :status, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.select :status, options_for_select([["Lead", "lead"], ["Prospect", "prospect"], ["Customer", "customer"]], @contact.status), {}, class: "input" %>
      </div>
      <div class="flex gap-4">
        <%= f.submit "Create contact", class: "btn-primary" %>
        <%= link_to "Cancel", contacts_path, class: "btn-quiet" %>
      </div>
    </div>
  <% end %>
</div>
