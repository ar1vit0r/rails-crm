<div class="flex justify-between items-center mb-8">
  <h1 class="text-2xl font-bold text-gray-100"><%= @contact.name %></h1>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_contact_path(@contact), class: "bg-gray-700 text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-600" %>
    <%= link_to "Add Activity", new_contact_activity_path(@contact), class: "bg-cyan-600 text-white px-4 py-2 rounded-lg hover:bg-cyan-700" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
  <div class="bg-gray-800 border border-gray-700 rounded-lg p-6">
    <h2 class="text-lg font-semibold text-gray-100 mb-4">Contact Info</h2>
    <dl class="space-y-3">
      <div>
        <dt class="text-sm text-gray-400">Email</dt>
        <dd class="text-gray-100"><%= @contact.email || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-400">Phone</dt>
        <dd class="text-gray-100"><%= @contact.phone || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-400">Company</dt>
        <dd class="text-gray-100"><%= @contact.company || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-400">Position</dt>
        <dd class="text-gray-100"><%= @contact.position || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-400">Status</dt>
        <dd>
          <span class="px-2 py-1 text-xs rounded <%= @contact.lead? ? 'bg-blue-900/50 text-blue-300 border border-blue-700' : @contact.prospect? ? 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' : 'bg-green-900/50 text-green-300 border border-green-700' %>">
            <%= @contact.status.humanize %>
          </span>
        </dd>
      </div>
    </dl>
  </div>

  <div class="bg-gray-800 border border-gray-700 rounded-lg p-6">
    <h2 class="text-lg font-semibold text-gray-100 mb-4">Activities</h2>
    <% if @activities.any? %>
      <div class="space-y-3">
        <% @activities.each do |activity| %>
          <div class="bg-gray-700 rounded-lg p-3">
            <div class="flex justify-between items-start">
              <span class="px-2 py-1 text-xs rounded bg-gray-600 text-gray-300"><%= activity.kind.humanize %></span>
              <span class="text-xs text-gray-400"><%= activity.performed_at&.strftime("%b %d, %Y") %></span>
            </div>
            <p class="text-sm text-gray-300 mt-2"><%= activity.body %></p>
            <% if activity.lead %>
              <p class="text-xs text-gray-400 mt-1">Lead: <%= activity.lead.title %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-400">No activities yet.</p>
    <% end %>
  </div>
</div>

<div class="mt-8">
  <%= link_to "Back to Contacts", contacts_path, class: "text-gray-400 hover:text-cyan-400" %>
</div>
