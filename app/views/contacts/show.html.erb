<div class="flex flex-wrap justify-between items-end gap-4">
  <div>
    <h1 class="display text-4xl md:text-5xl font-extrabold text-bone"><%= @contact.name %></h1>
    <% headline = [@contact.position, @contact.company].compact_blank.join(", ") %>
    <% if headline.present? %>
      <p class="mt-2 text-lg text-gray-300"><%= headline %></p>
    <% end %>
  </div>
  <div class="flex gap-3">
    <%= link_to "Edit", edit_contact_path(@contact), class: "btn-quiet" %>
    <%= link_to "Add activity", new_contact_activity_path(@contact), class: "btn-primary" %>
  </div>
</div>

<div class="mt-10 grid grid-cols-1 md:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] gap-x-16 gap-y-10">
  <dl class="space-y-4">
    <% { "Status" => @contact.status.humanize, "Email" => @contact.email, "Phone" => @contact.phone }.compact_blank.each do |label, value| %>
      <div>
        <dt class="text-sm text-gray-400"><%= label %></dt>
        <dd class="text-bone break-words"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <section class="max-w-2xl">
    <h2 class="text-xl font-semibold mb-6">Activity</h2>
    <% if @activities.present? %>
      <%= render "activities/timeline", activities: @activities, show_lead: true %>
    <% else %>
      <p class="text-gray-300">
        No activity yet.
        <%= link_to "Log a call or note", new_contact_activity_path(@contact), class: "text-bone underline underline-offset-4 hover:text-lichen" %>
      </p>
    <% end %>
  </section>
</div>

<p class="mt-12">
  <%= link_to "All contacts", contacts_path, class: "text-gray-400 hover:text-bone" %>
</p>
