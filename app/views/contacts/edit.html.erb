<h1 class="text-2xl font-bold text-gray-100 mb-8">Edit Contact</h1>

<div class="bg-gray-800 border border-gray-700 rounded-lg p-6 max-w-2xl">
  <%= form_with model: @contact, local: true do |f| %>
    <% if @contact.errors.any? %>
      <div class="bg-red-900/50 text-red-300 border border-red-700 px-4 py-2 rounded mb-4">
        <ul class="list-disc list-inside">
          <% @contact.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :name, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :name, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :email, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.email_field :email, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :phone, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :phone, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :company, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :company, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :position, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :position, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :status, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.select :status, options_for_select([["Lead", "lead"], ["Prospect", "prospect"], ["Customer", "customer"]], @contact.status), {}, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div class="flex gap-4">
        <%= f.submit "Update Contact", class: "bg-cyan-600 text-white px-6 py-2 rounded-lg hover:bg-cyan-700" %>
        <%= link_to "Cancel", contact_path(@contact), class: "bg-gray-700 text-gray-300 px-6 py-2 rounded-lg hover:bg-gray-600" %>
      </div>
    </div>
  <% end %>
</div>
