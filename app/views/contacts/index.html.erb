<div class="flex flex-wrap justify-between items-end gap-4">
  <h1 class="display text-4xl md:text-5xl font-extrabold text-bone">Contacts</h1>
  <%= link_to "New contact", new_contact_path, class: "btn-primary" %>
</div>

<%= form_tag contacts_path, method: :get, class: "mt-6 flex flex-wrap gap-3" do %>
  <%= label_tag :search, "Search contacts", class: "sr-only" %>
  <%= text_field_tag :search, params[:search], placeholder: "Name or company", class: "input sm:w-72" %>
  <%= label_tag :status, "Status", class: "sr-only" %>
  <%= select_tag :status, options_for_select([["All statuses", ""], ["Lead", "lead"], ["Prospect", "prospect"], ["Customer", "customer"]], params[:status]), class: "input sm:w-44" %>
  <%= submit_tag "Filter", class: "btn-quiet" %>
<% end %>

<% if @contacts.present? %>
  <ul class="mt-8 border-y border-gray-700 divide-y divide-gray-700">
    <% @contacts.each do |contact| %>
      <li class="flex items-center gap-4 py-4">
        <div class="min-w-0 flex-1">
          <%= link_to contact.name, contact_path(contact), class: "block truncate text-lg font-semibold text-bone hover:text-lichen" %>
          <p class="truncate text-sm text-gray-400"><%= [contact.company, contact.email].compact_blank.join(", ") %></p>
        </div>
        <p class="text-sm text-gray-300"><%= contact.status.humanize %></p>
        <div class="flex flex-col items-end gap-1 text-sm">
          <%= link_to "Edit", edit_contact_path(contact), class: "text-gray-400 hover:text-bone" %>
          <%= button_to "Delete", contact_path(contact), method: :delete, form_class: "inline", class: "text-gray-400 hover:text-madder cursor-pointer", data: { turbo_confirm: "Delete this contact?" } %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="mt-8 text-gray-300">
    <%= params[:search].present? || params[:status].present? ? "No contacts match." : "No contacts yet." %>
    <%= link_to "Add a contact", new_contact_path, class: "text-bone underline underline-offset-4 hover:text-lichen" %>
  </p>
<% end %>
