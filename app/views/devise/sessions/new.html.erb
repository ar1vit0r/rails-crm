<h1 class="display text-4xl md:text-5xl font-extrabold text-bone">Log in</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 max-w-md space-y-4" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm text-gray-400 mb-1" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm text-gray-400 mb-1" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "input" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :remember_me, class: "h-4 w-4 accent-lichen" %>
      <%= f.label :remember_me, class: "text-sm text-gray-300" %>
    </div>
  <% end %>

  <%= f.submit "Log in", class: "btn-primary" %>
<% end %>

<div class="mt-8"><%= render "devise/shared/links" %></div>
