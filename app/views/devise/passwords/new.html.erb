<h1 class="display text-4xl md:text-5xl font-extrabold text-bone">Forgot your password?</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 max-w-md space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :email, class: "block text-sm text-gray-400 mb-1" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
  </div>

  <%= f.submit "Send reset instructions", class: "btn-primary" %>
<% end %>

<div class="mt-8"><%= render "devise/shared/links" %></div>
