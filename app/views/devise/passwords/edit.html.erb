<h1 class="display text-4xl md:text-5xl font-extrabold text-bone">Change your password</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-8 max-w-md space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div>
    <%= f.label :password, "New password", class: "block text-sm text-gray-400 mb-1" %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "input" %>
    <% if @minimum_password_length %>
      <p class="mt-1 text-sm text-gray-400"><%= @minimum_password_length %> characters minimum</p>
    <% end %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm text-gray-400 mb-1" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
  </div>

  <%= f.submit "Change password", class: "btn-primary" %>
<% end %>

<div class="mt-8"><%= render "devise/shared/links" %></div>
