<div class="flex flex-wrap justify-between items-end gap-4">
  <div class="border-l-4 pl-4 <%= stage_border(@lead) %>">
    <h1 class="display text-4xl md:text-5xl font-extrabold text-bone"><%= @lead.title %></h1>
    <p class="mt-2 text-lg text-gray-300"><%= stage_label(@lead) %> for <%= link_to @lead.contact.name, contact_path(@lead.contact), class: "underline underline-offset-4 hover:text-bone" %></p>
  </div>
  <div class="flex gap-3">
    <%= link_to "Edit", edit_lead_path(@lead), class: "btn-quiet" %>
    <%= link_to "Add activity", new_lead_activity_path(@lead), class: "btn-primary" %>
  </div>
</div>

<div class="mt-10 grid grid-cols-1 md:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] gap-x-16 gap-y-10">
  <dl class="space-y-4">
    <div>
      <dt class="text-sm text-gray-400">Value</dt>
      <dd class="display text-4xl font-bold tabular-nums <%= @lead.won? ? 'text-marigold' : 'text-bone' %>">$<%= number_with_precision(@lead.value, precision: 2) %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-400">Priority</dt>
      <dd class="flex items-center gap-2 text-bone"><%= priority_pips(@lead) %> <%= Lead.priorities.key(Lead.priorities.fetch(@lead.priority, 0)).humanize %></dd>
    </div>
    <% if @lead.closes_at %>
      <div>
        <dt class="text-sm text-gray-400">Closes</dt>
        <dd class="text-bone"><%= @lead.closes_at.strftime("%b %d, %Y") %></dd>
      </div>
    <% end %>
    <% if @lead.description.present? %>
      <div>
        <dt class="text-sm text-gray-400">Description</dt>
        <dd class="text-bone"><%= @lead.description %></dd>
      </div>
    <% end %>
  </dl>

  <section class="max-w-2xl">
    <h2 class="text-xl font-semibold mb-6">Activity</h2>
    <% if @activities.any? %>
      <%= render "activities/timeline", activities: @activities %>
    <% else %>
      <p class="text-gray-300">
        No activity yet.
        <%= link_to "Log a call or note", new_lead_activity_path(@lead), class: "text-bone underline underline-offset-4 hover:text-lichen" %>
      </p>
    <% end %>
  </section>
</div>

<p class="mt-12">
  <%= link_to "All leads", leads_path, class: "text-gray-400 hover:text-bone" %>
</p>
