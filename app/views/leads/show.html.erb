<div class="flex justify-between items-center mb-8">
  <h1 class="text-2xl font-bold text-gray-100"><%= @lead.title %></h1>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_lead_path(@lead), class: "bg-gray-700 text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-600" %>
    <%= link_to "Add Activity", new_lead_activity_path(@lead), class: "bg-cyan-600 text-white px-4 py-2 rounded-lg hover:bg-cyan-700" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
  <div class="bg-gray-800 border border-gray-700 rounded-lg p-6">
    <h2 class="text-lg font-semibold text-gray-100 mb-4">Lead Info</h2>
    <dl class="space-y-3">
      <div>
        <dt class="text-sm text-gray-400">Contact</dt>
        <dd class="text-gray-100"><%= link_to @lead.contact.name, contact_path(@lead.contact), class: "hover:text-cyan-400" %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-400">Description</dt>
        <dd class="text-gray-100"><%= @lead.description || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-400">Status</dt>
        <dd>
          <span class="px-2 py-1 text-xs rounded <%= @lead.new? ? 'bg-blue-900/50 text-blue-300 border border-blue-700' : @lead.qualified? ? 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' : @lead.proposal? ? 'bg-purple-900/50 text-purple-300 border border-purple-700' : @lead.won? ? 'bg-green-900/50 text-green-300 border border-green-700' : 'bg-red-900/50 text-red-300 border border-red-700' %>">
            <%= @lead.status.humanize %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-gray-400">Priority</dt>
        <dd>
          <span class="px-2 py-1 text-xs rounded <%= @lead.high? ? 'bg-red-900/50 text-red-300 border border-red-700' : @lead.medium? ? 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' : 'bg-gray-700 text-gray-300 border border-gray-600' %>">
            <%= @lead.priority.humanize %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="text-sm text-gray-400">Value</dt>
        <dd class="text-gray-100 text-lg font-semibold">$<%= number_with_precision(@lead.value, precision: 2) %></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-400">Closes At</dt>
        <dd class="text-gray-100"><%= @lead.closes_at&.strftime("%b %d, %Y") || "—" %></dd>
      </div>
    </dl>
  </div>

  <div class="bg-gray-800 border border-gray-700 rounded-lg p-6">
    <h2 class="text-lg font-semibold text-gray-100 mb-4">Activities</h2>
    <% if @activities.any? %>
      <div class="space-y-3">
        <% @activities.each do |activity| %>
          <div class="bg-gray-700 rounded-lg p-3">
            <div class="flex justify-between items-start">
              <span class="px-2 py-1 text-xs rounded bg-gray-600 text-gray-300"><%= activity.kind.humanize %></span>
              <span class="text-xs text-gray-400"><%= activity.performed_at&.strftime("%b %d, %Y") %></span>
            </div>
            <p class="text-sm text-gray-300 mt-2"><%= activity.body %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-400">No activities yet.</p>
    <% end %>
  </div>
</div>

<div class="mt-8">
  <%= link_to "Back to Leads", leads_path, class: "text-gray-400 hover:text-cyan-400" %>
</div>
