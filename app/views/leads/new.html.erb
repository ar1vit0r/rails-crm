<h1 class="display text-4xl md:text-5xl font-extrabold text-bone">New lead</h1>

<div class="mt-8 max-w-xl">
  <%= form_with model: @lead, local: true do |f| %>
    <% if @lead.errors.any? %>
      <div role="alert" class="bg-moss text-madder border-l-4 border-madder px-4 py-2 mb-6">
        <ul class="list-disc list-inside">
          <% @lead.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :title, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :title, class: "input" %>
      </div>
      <div>
        <%= f.label :description, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_area :description, rows: 3, class: "input" %>
      </div>
      <div>
        <%= f.label :contact_id, "Contact", class: "block text-sm text-gray-400 mb-1" %>
        <%= f.collection_select :contact_id, @contacts, :id, :name, {}, class: "input" %>
      </div>
      <div>
        <%= f.label :status, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.select :status, options_for_select([["New", "new"], ["Qualified", "qualified"], ["Proposal", "proposal"], ["Won", "won"], ["Lost", "lost"]], @lead.status), {}, class: "input" %>
      </div>
      <div>
        <%= f.label :value, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.number_field :value, step: 0.01, class: "input" %>
      </div>
      <div>
        <%= f.label :priority, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.select :priority, options_for_select([["Low", "low"], ["Medium", "medium"], ["High", "high"]], @lead.priority), {}, class: "input" %>
      </div>
      <div>
        <%= f.label :closes_at, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.date_field :closes_at, class: "input" %>
      </div>
      <div class="flex gap-4">
        <%= f.submit "Create lead", class: "btn-primary" %>
        <%= link_to "Cancel", leads_path, class: "btn-quiet" %>
      </div>
    </div>
  <% end %>
</div>
