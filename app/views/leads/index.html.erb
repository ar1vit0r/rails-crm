<div class="flex flex-wrap justify-between items-end gap-4">
  <h1 class="display text-4xl md:text-5xl font-extrabold text-bone">Leads</h1>
  <%= link_to "New lead", new_lead_path, class: "btn-primary" %>
</div>

<nav aria-label="Filter by stage" class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
  <% [["All", nil], ["New", "new"], ["Qualified", "qualified"], ["Proposal", "proposal"], ["Won", "won"], ["Lost", "lost"]].each do |label, status| %>
    <% current = params[:status].presence == status %>
    <%= link_to label, leads_path(status: status), aria: { current: ("page" if current) },
          class: "py-1 border-b-2 #{current ? 'border-bone text-bone' : 'border-transparent text-gray-400 hover:text-bone'}" %>
  <% end %>
</nav>

<% if @leads.any? %>
  <ul class="mt-8 border-y border-gray-700 divide-y divide-gray-700">
    <% @leads.each do |lead| %>
      <li class="flex items-center gap-4 border-l-4 py-4 pl-4 <%= stage_border(lead) %>">
        <div class="min-w-0 flex-1">
          <%= link_to lead.title, lead_path(lead), class: "block truncate text-lg font-semibold text-bone hover:text-lichen" %>
          <p class="truncate text-sm text-gray-400"><span class="text-gray-300"><%= stage_label(lead) %></span> for <%= lead.contact.name %></p>
        </div>
        <div class="text-right">
          <p class="display text-2xl font-bold tabular-nums">$<%= number_with_precision(lead.value, precision: 2) %></p>
          <%= priority_pips(lead) %>
        </div>
        <div class="flex flex-col items-end gap-1 text-sm">
          <%= link_to "Edit", edit_lead_path(lead), class: "text-gray-400 hover:text-bone" %>
          <%= button_to "Delete", lead_path(lead), method: :delete, form_class: "inline", class: "text-gray-400 hover:text-madder cursor-pointer", data: { turbo_confirm: "Delete this lead?" } %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="mt-8 text-gray-300">
    <%= params[:status].present? ? "No leads at this stage." : "No leads yet." %>
    <%= link_to "Add a lead", new_lead_path, class: "text-bone underline underline-offset-4 hover:text-lichen" %>
  </p>
<% end %>
