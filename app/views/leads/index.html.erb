<div class="flex justify-between items-center mb-8">
  <h1 class="text-2xl font-bold text-gray-100">Leads</h1>
  <%= link_to "New Lead", new_lead_path, class: "bg-cyan-600 text-white px-4 py-2 rounded-lg hover:bg-cyan-700" %>
</div>

<div class="mb-6 flex gap-4">
  <%= form_tag leads_path, method: :get, class: "flex gap-4" do %>
    <%= select_tag :status, options_for_select([["All", ""], ["New", "new"], ["Qualified", "qualified"], ["Proposal", "proposal"], ["Won", "won"], ["Lost", "lost"]], params[:status]), class: "bg-gray-800 border border-gray-700 text-gray-100 px-4 py-2 rounded-lg" %>
    <%= submit_tag "Filter", class: "bg-gray-700 text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-600" %>
  <% end %>
</div>

<% if @leads.any? %>
  <div class="bg-gray-800 border border-gray-700 rounded-lg overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-700">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-semibold text-gray-300">Title</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-gray-300">Contact</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-gray-300">Status</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-gray-300">Priority</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-gray-300">Value</th>
          <th class="px-4 py-3 text-left text-sm font-semibold text-gray-300">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-700">
        <% @leads.each do |lead| %>
          <tr class="hover:bg-gray-750">
            <td class="px-4 py-3 text-gray-100"><%= link_to lead.title, lead_path(lead), class: "hover:text-cyan-400" %></td>
            <td class="px-4 py-3 text-gray-400"><%= lead.contact.name %></td>
            <td class="px-4 py-3">
              <span class="px-2 py-1 text-xs rounded <%= lead.new_lead? ? 'bg-blue-900/50 text-blue-300 border border-blue-700' : lead.qualified? ? 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' : lead.proposal? ? 'bg-purple-900/50 text-purple-300 border border-purple-700' : lead.won? ? 'bg-green-900/50 text-green-300 border border-green-700' : 'bg-red-900/50 text-red-300 border border-red-700' %>">
                <%= lead.status.humanize %>
              </span>
            </td>
            <td class="px-4 py-3">
              <span class="px-2 py-1 text-xs rounded <%= lead.high? ? 'bg-red-900/50 text-red-300 border border-red-700' : lead.medium? ? 'bg-yellow-900/50 text-yellow-300 border border-yellow-700' : 'bg-gray-700 text-gray-300 border border-gray-600' %>">
                <%= lead.priority.humanize %>
              </span>
            </td>
            <td class="px-4 py-3 text-gray-100">$<%= number_with_precision(lead.value, precision: 2) %></td>
            <td class="px-4 py-3">
              <%= link_to "Edit", edit_lead_path(lead), class: "text-gray-400 hover:text-cyan-400 mr-3" %>
              <%= button_to "Delete", lead_path(lead), method: :delete, class: "text-gray-400 hover:text-red-400", data: { turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-gray-400">No leads found. Create one to get started!</p>
<% end %>
