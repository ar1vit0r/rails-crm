<h1 class="text-2xl font-bold text-gray-100 mb-8">Edit Lead</h1>

<div class="bg-gray-800 border border-gray-700 rounded-lg p-6 max-w-2xl">
  <%= form_with model: @lead, local: true do |f| %>
    <% if @lead.errors.any? %>
      <div class="bg-red-900/50 text-red-300 border border-red-700 px-4 py-2 rounded mb-4">
        <ul class="list-disc list-inside">
          <% @lead.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :title, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_field :title, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :description, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.text_area :description, rows: 3, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :contact_id, "Contact", class: "block text-sm text-gray-400 mb-1" %>
        <%= f.collection_select :contact_id, @contacts, :id, :name, {}, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :status, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.select :status, options_for_select([["New", "new"], ["Qualified", "qualified"], ["Proposal", "proposal"], ["Won", "won"], ["Lost", "lost"]], @lead.status), {}, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :value, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.number_field :value, step: 0.01, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :priority, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.select :priority, options_for_select([["Low", "low"], ["Medium", "medium"], ["High", "high"]], @lead.priority), {}, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div>
        <%= f.label :closes_at, class: "block text-sm text-gray-400 mb-1" %>
        <%= f.date_field :closes_at, class: "w-full bg-gray-700 border border-gray-600 text-gray-100 px-4 py-2 rounded-lg" %>
      </div>
      <div class="flex gap-4">
        <%= f.submit "Update Lead", class: "bg-cyan-600 text-white px-6 py-2 rounded-lg hover:bg-cyan-700" %>
        <%= link_to "Cancel", lead_path(@lead), class: "bg-gray-700 text-gray-300 px-6 py-2 rounded-lg hover:bg-gray-600" %>
      </div>
    </div>
  <% end %>
</div>
